<urn:usf:type:ProductExclusion> <urn:usf:predicate:objective> "A concern a profile explicitly declines to own, with its reason." <urn:usf:graph:product-profile-vocabulary> .
<urn:usf:type:ProductExclusion> <urn:usf:predicate:type> <urn:usf:type:SemanticType> <urn:usf:graph:product-profile-vocabulary> .
<urn:usf:type:ProductOpportunity> <urn:usf:predicate:objective> "A credible product opportunity recorded without being promoted into required scope." <urn:usf:graph:product-profile-vocabulary> .
<urn:usf:type:ProductOpportunity> <urn:usf:predicate:type> <urn:usf:type:SemanticType> <urn:usf:graph:product-profile-vocabulary> .
<urn:usf:type:ProductScopeDisposition> <urn:usf:predicate:objective> "A named product-scope stance a profile may take on a capability." <urn:usf:graph:product-profile-vocabulary> .
<urn:usf:type:ProductScopeDisposition> <urn:usf:predicate:type> <urn:usf:type:SemanticType> <urn:usf:graph:product-profile-vocabulary> .
