<urn:usf:product-scope-disposition:deferred> <urn:usf:predicate:dispositionMeaning> "Real, applicable and deliberately postponed beyond this profile revision." <urn:usf:graph:product-profile-vocabulary> .
<urn:usf:product-scope-disposition:deferred> <urn:usf:predicate:type> <urn:usf:type:ProductScopeDisposition> <urn:usf:graph:product-profile-vocabulary> .
