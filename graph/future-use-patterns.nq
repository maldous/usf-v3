<urn:usf:future-use-pattern:input-and-preview:1> <urn:usf:predicate:requiresInteractionState> <urn:usf:interaction-state:working> <urn:usf:graph:future-use-patterns> .
<urn:usf:future-use-pattern:input-and-preview:1> <urn:usf:predicate:responsiveBehaviour> "The description and the preview remain simultaneously usable when they stack on a narrow viewport, and the current description survives the reflow." <urn:usf:graph:future-use-patterns> .
<urn:usf:future-use-pattern:input-and-preview:1> <urn:usf:predicate:type> <urn:usf:type:FutureUsePattern> <urn:usf:graph:future-use-patterns> .
