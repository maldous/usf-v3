<urn:usf:linear-binding:usf-1162-fixture-repair:1> <urn:usf:predicate:fixedPrompt> "USF-1162 bounded fixture repair. The existing current authoritative work/profile permits this test file. You own ONLY tests/unit/commands/linear-binding.test.ts; other agents are working independently, so do not edit files or revert other work. Return only a JSON object {\"operations\":[{\"kind\":\"replace\",\"path\":\"tests/unit/commands/linear-binding.test.ts\",\"oldText\":\"unique exact supplied anchor\",\"newText\":\"replacement\"}]}. No tools, markdown, runtime changes, new services, provider changes or acceptance weakening.\nObserved defect: the fixture copies the current linear-work-binding grants graph but does not copy its matching generated publication receipt. Its ordinary fixture evidence/prove/publish call then refuses CONSTRUCTION_PUBLICATION_PARTIAL_STATE before every binding assertion. The primary grant and receipt are intact; this is a fixture construction defect. The grants file contains only generated Evidence/ProofResult/ConstructionAuthorityGrant records; authored contracts/policies are in the separate linear-work-binding graph.\nMake the fixture self-contained: initialise ONLY its copied graph-selected grants source to the original three-line static empty marker state before the existing evidence/prove/publish sequence, leaving sourceRoot, the primary graph, all imported authority, every policy and assertion untouched. The existing calls must create and independently authenticate its fresh grant in this disposable fixture. Do not copy ambient runtime/credentials, add a changing receipt filename to read scope, skip publication, mock proof, loosen currentness, or alter production code. Import the existing deriveConstructionAuthority(graph, work, manifestPath) from ../../../src/realisation/construction-authority.ts; it returns sourcePath and targetGraphIri. Use its sourcePath instead of hard-coding the grants path, preserving the static empty-marker records shown below. Use existing writeFile/resolve imports; no new package. Add a concise comment explaining why imported grant records without their receipt cannot seed a fixture. Preserve all 16 existing assertions and actual generated-graph/Hermes parser checks.\nExact static initial marker records (use the selected targetGraphIri for their named graph):\n<urn:usf:record:linear-work-binding-grants-empty> <urn:usf:predicate:forContract> <urn:usf:contract:linear-work-binding:1> <urn:usf:graph:linear-work-binding-grants> .\n<urn:usf:record:linear-work-binding-grants-empty> <urn:usf:predicate:text> \"No construction or completion authority is published in this source.\" <urn:usf:graph:linear-work-binding-grants> .\n<urn:usf:record:linear-work-binding-grants-empty> <urn:usf:predicate:type> <urn:usf:type:SemanticRecordType> <urn:usf:graph:linear-work-binding-grants> .\n\nFull source preimage: sha256:cf0ac5abbefe52ba9b2298e14cbe266520c2ca1a64a962157e37332026e5f6ff. Exact source slice:\nimport assert from \"node:assert/strict\";\nimport { createHash } from \"node:crypto\";\nimport { canonicalDigest, canonicalJson } from \"../../../src/core/canonical.ts\";\nimport { deriveWork } from \"../../../src/graph/work.ts\";\nimport { loadSemanticGraph, validationRuntimeClosure } from \"../../../src/graph/index.ts\";\nimport { canonicalQuadDigest, parseStrictNQuads } from \"../../../src/graph/nquads.ts\";\nimport { constructionAwarePublishCommandHandler, evidenceCommandHandler, proveCommandHandler } from \"../../../src/commands/construction-authority.ts\";\nimport { access, mkdir, mkdtemp, readFile, readdir, rm, symlink, writeFile } from \"node:fs/promises\";\nimport { tmpdir } from \"node:os\";\nimport { join, resolve } from \"node:path\";\nimport test from \"node:test\";\nimport { bindingSelector } from \"../../../src/commands/hermes.ts\";\nimport {\n  LinearBindingError,\n  afterHermesResult,\n  beforeHermesDispatch,\n  observeLinearBinding,\n  prepareLinearBinding,\n  type GraphExecutionEvidenceDigest,\n  type LinearBindingSelector,\n} from \"../../../src/commands/linear-binding.ts\";\n\nconst manifestPath = \"graph/manifests/linear-work-binding.json\";\nconst bindingManifestPath = \"graph/manifests/linear-binding-authority.json\";\nconst bindingGraphPath = \"graph/linear-binding-authority.nq\";\nconst sourceRoot = resolve(import.meta.dirname, \"../../..\");\nconst testRoots = new Set<string>();\n\ntest.afterEach(async () => {\n  await Promise.all([...testRoots].map(async (root) => rm(root, { recursive: true, force: true })));\n  testRoots.clear();\n});\n\nfunction reason(reasonCode: string): (error: unknown) => boolean {\n  return (error) => error instanceof LinearBindingError && error.reasonCode === reasonCode;\n}\n\nasync function fixtureRoot(): Promise<string> {\n  const root = await mkdtemp(join(process.env.TMPDIR ?? tmpdir(), \"usf-linear-binding-\"));\n  testRoots.add(root);\n\n  const work = \"urn:usf:work:linear-work-binding\";\n  const profile = \"urn:usf:profile:linear-work-binding:1\";\n  const obligation = \"urn:usf:proof:linear-work-binding:construction-authority\";\n  const graph = loadSemanticGraph(sourceRoot, manifestPath);\n  const result = deriveWork(graph, { selector: work, profile, maxItems: 1 });\n  assert.equal(result.status, \"ok\");\n  assert.equal(result.items?.length, 1);\n  const selected = result.items![0];\n  const basis = selected.realisationBasis;\n  assert.ok(basis);\n\n  const requiredPaths = new Set<string>([\n    manifestPath,\n    ...validationRuntimeClosure(graph, \"urn:usf:validation:linear-work-binding\").repositoryReadFiles,\n    ...selected.readSet,\n    ...basis.scope.readSet,\n    ...Object.keys(basis.scope.preimages),\n    ...basis.inputs.schemaDigests.map(({ id }) => id),\n    ...basis.inputs.toolDigests.map(({ id }) => id),\n  ]);\n  const optionalWritePaths = new Set<string>([\n    ...selected.writeSet,\n    ...basis.scope.writeSet,\n  ]);\n  for (const path of requiredPaths) optionalWritePaths.delete(path);\n\n  const files = new Map<string, Buffer>();\n  const pending = [...requiredPaths];\n  while (pending.length > 0) {\n    const path = pending.pop()!;\n    if (files.has(path)) continue;\n    const bytes = await readFile(resolve(sourceRoot, path));\n    files.set(path, bytes);\n    if (path.endsWith(\".json\")) {\n      const value = JSON.parse(bytes.toString(\"utf8\")) as { imports?: string[]; sources?: Array<{ path: string }> };\n      for (const importedPath of [...(value.imports ?? []), ...(value.sources ?? []).map(({ path: sourcePath }) => sourcePath)]) {\n        if (!files.has(importedPath)) pending.push(importedPath);\n      }\n    }\n  }\n  for (const path of optionalWritePaths) {\n    try {\n      files.set(path, await readFile(resolve(sourceRoot, path)));\n    } catch (error) {\n      if ((error as NodeJS.ErrnoException).code !== \"ENOENT\") throw error;\n    }\n  }\n  for (const [path, bytes] of files) {\n    await mkdir(resolve(root, path, \"..\"), { recursive: true });\n    await writeFile(resolve(root, path), bytes);\n  }\n\n  const evidencePath = \".usf/candidates/construction-authority/linear-binding-evidence.json\";\n  const bundlePath = \".usf/candidates/construction-authority/linear-binding-bundle.json\";\n  await mkdir(resolve(root, \".usf/candidates/construction-authority\"), { recursive: true, mode: 0o700 });\n  const evidenceResult = await evidenceCommandHandler({\n    command: \"evidence\",\n    repositoryRoot: root,\n    args: [\"construction\", \"--work\", work, \"--profile\", profile, \"--manifest\", manifestPath, \"--output\", evidencePath],\n  });\n  assert.equal(evidenceResult.exitCode ?? 0, 0);\n  assert.equal((evidenceResult.output as { status: unknown }).status, \"candidate\");\n  const proofResult = await proveCommandHandler({\n    command: \"prove\",\n    repositoryRoot: root,\n    args: [\"construction\", \"--obligation\", obligation, \"--evidence\", evidencePath, \"--profile\", profile, \"--manifest\", manifestPath, \"--output\", bundlePath],\n  });\n  assert.equal(proofResult.exitCode ?? 0, 0);\n  assert.equal((proofResult.output as { proof: { outcome: unknown } }).proof.outcome, \"pass\");\n  const publicationResult = await constructionAwarePublishCommandHandler({\n    command: \"publish\",\n    repositoryRoot: root,\n    args: [\"construction-authority\", \"--bundle\", bundlePath, \"--profile\", profile, \"--manifest\", manifestPath, \"--apply\"],\n  });\n  assert.equal(publicationResult.exitCode ?? 0, 0);\n  assert.equal((publicationResult.output as { status: unknown }).status, \"ok\");\n\n  await mkdir(resolve(root, \"graph/manifests\"), { recursive: true });\n  return root;\n}\n" <urn:usf:graph:linear-issue-bindings> .
