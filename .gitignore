# Repository-contained mutable state
.usf/

# Secrets and local environment
.env
.env.*
!.env.example

# Dependency and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Generated observation output. The clean-clone fixture already excludes this as
# runtime state rather than source input; leaving it merely untracked risks
# committing generated bytes that a fresh clone must reproduce, not inherit.
artifacts/

# Editor and operating-system state
.DS_Store
*.swp
*.swo
