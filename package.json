{
  "name": "usf-v3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Repository-contained semantic delivery foundation for ANQR",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "./scripts/bootstrap.sh",
    "check:containment": "./scripts/verify-contained.sh",
    "test:unit": "node --test 'tests/unit/**/*.test.ts'",
    "test:contract": "node --test 'tests/contract/**/*.test.ts'",
    "test:integration": "node --test 'tests/integration/**/*.test.ts' 'apps/**/test/**/*.test.ts'",
    "test:adversarial": "node --test 'tests/adversarial/**/*.test.ts'",
    "test:scale": "node --test 'tests/scale/**/*.test.ts'",
    "test:lifecycle": "node --test tests/unit/continuous/lifecycle.test.ts tests/integration/lifecycle-process.test.ts",
    "test:fast": "node --test 'tests/unit/**/*.test.ts' 'tests/contract/**/*.test.ts'",
    "test:full": "node --test 'tests/**/*.test.ts' 'apps/**/test/**/*.test.ts'",
    "test": "node --run test:full",
    "typecheck": "tsc --noEmit",
    "check:fast": "node --run typecheck && node --run test:fast",
    "check": "node --run typecheck && node --run test:full"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@ai-sdk/cerebras": "3.0.40",
    "@ai-sdk/cohere": "4.0.35",
    "@ai-sdk/groq": "4.0.34",
    "@ai-sdk/mistral": "4.0.37",
    "@ai-sdk/openai": "4.0.52",
    "@ai-sdk/openai-compatible": "3.0.41",
    "@ai-sdk/togetherai": "3.0.42",
    "@apidevtools/swagger-parser": "12.1.0",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@traqula/parser-sparql-1-1": "1.2.1",
    "ai": "7.0.84",
    "ajv": "8.20.0",
    "graphql": "17.0.2",
    "n3": "2.0.1",
    "oxigraph": "0.5.9",
    "rdf-canonize": "5.0.0",
    "rdf-validate-shacl": "0.6.5",
    "yaml": "2.9.0"
  }
}
