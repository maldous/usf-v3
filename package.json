{
  "name": "usf-v3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Repository-contained semantic delivery foundation for ANQR",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "./scripts/bootstrap.sh",
    "check:containment": "./scripts/verify-contained.sh",
    "test": "node --test --test-force-exit 'tests/**/*.test.ts' 'apps/**/test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "check": "node --run typecheck && node --run test"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "8.20.0",
    "n3": "2.0.1",
    "oxigraph": "0.5.9",
    "rdf-canonize": "5.0.0",
    "rdf-validate-shacl": "0.6.5"
  }
}
