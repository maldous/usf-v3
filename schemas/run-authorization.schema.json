{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:run-authorization:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "routeMemberDigest",
    "candidateMemberDigest",
    "requestedModelIdentity",
    "accountSourceUseAuthorizationDigest",
    "accountObservationDigest",
    "routeModelEconomicsBindingDigest",
    "credentialSourceIdentityDigest",
    "adapterPreflightDigest",
    "profileDigest",
    "effectivePolicyDigest",
    "privacyProjectionDigest",
    "taskDigest",
    "promptOnlyProjectionDigest",
    "maximumInputBytes",
    "maximumOutputTokens",
    "timeoutMilliseconds",
    "issuedAt",
    "expiresAt",
    "fallbackProhibited",
    "paidCostCeiling",
    "authorizationDisposition"
  ],
  "properties": {
    "schema": {
      "const": "urn:usf:run-authorization:1"
    },
    "version": {
      "const": 1
    },
    "routeMemberDigest": {
      "$ref": "#/$defs/digest"
    },
    "candidateMemberDigest": {
      "$ref": "#/$defs/digest"
    },
    "requestedModelIdentity": {
      "$ref": "#/$defs/modelIdentity"
    },
    "accountSourceUseAuthorizationDigest": {
      "$ref": "#/$defs/digest"
    },
    "accountObservationDigest": {
      "$ref": "#/$defs/digest"
    },
    "routeModelEconomicsBindingDigest": {
      "$ref": "#/$defs/digest"
    },
    "credentialSourceIdentityDigest": {
      "$ref": "#/$defs/digest"
    },
    "adapterPreflightDigest": {
      "$ref": "#/$defs/digest"
    },
    "profileDigest": {
      "$ref": "#/$defs/digest"
    },
    "effectivePolicyDigest": {
      "$ref": "#/$defs/digest"
    },
    "privacyProjectionDigest": {
      "$ref": "#/$defs/digest"
    },
    "taskDigest": {
      "$ref": "#/$defs/digest"
    },
    "promptOnlyProjectionDigest": {
      "$ref": "#/$defs/digest"
    },
    "maximumInputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "maximumOutputTokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "timeoutMilliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000
    },
    "issuedAt": {
      "$ref": "#/$defs/instant"
    },
    "expiresAt": {
      "$ref": "#/$defs/instant"
    },
    "fallbackProhibited": {
      "const": true
    },
    "paidCostCeiling": {
      "const": "0"
    },
    "authorizationDisposition": {
      "const": "authorized"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{0,191}$"
    },
    "modelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "provider",
        "model"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/identifier"
        },
        "provider": {
          "$ref": "#/$defs/identifier"
        },
        "model": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
