{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:route-qualification-receipt:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "routeMemberDigest",
    "candidateMemberDigest",
    "taskProfileDigest",
    "accountObservationDigest",
    "routeModelEconomicsBindingDigest",
    "adapterPreflightDigest",
    "providerAnswerDigest",
    "hiddenEvaluationDigest",
    "requestedIdentity",
    "actualIdentity",
    "roles",
    "disposition",
    "reasonCodes",
    "qualifiedAt",
    "expiresAt"
  ],
  "properties": {
    "schema": {
      "const": "urn:usf:route-qualification-receipt:1"
    },
    "version": {
      "const": 1
    },
    "routeMemberDigest": {
      "$ref": "#/$defs/digest"
    },
    "candidateMemberDigest": {
      "$ref": "#/$defs/digest"
    },
    "taskProfileDigest": {
      "$ref": "#/$defs/digest"
    },
    "accountObservationDigest": {
      "$ref": "#/$defs/digest"
    },
    "routeModelEconomicsBindingDigest": {
      "$ref": "#/$defs/digest"
    },
    "adapterPreflightDigest": {
      "$ref": "#/$defs/digest"
    },
    "providerAnswerDigest": {
      "$ref": "#/$defs/digest"
    },
    "hiddenEvaluationDigest": {
      "$ref": "#/$defs/digest"
    },
    "requestedIdentity": {
      "$ref": "#/$defs/modelIdentity"
    },
    "actualIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "provider",
        "model",
        "sdkProvider"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/identifier"
        },
        "provider": {
          "$ref": "#/$defs/identifier"
        },
        "model": {
          "$ref": "#/$defs/identifier"
        },
        "sdkProvider": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "disposition": {
      "enum": [
        "QUALIFIED",
        "UNQUALIFIED",
        "DEFERRED"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/reasonCode"
      }
    },
    "qualifiedAt": {
      "$ref": "#/$defs/instant"
    },
    "expiresAt": {
      "$ref": "#/$defs/instant"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{0,191}$"
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]{1,95}(?::[^\\s]{1,192})?$"
    },
    "modelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "provider",
        "model"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/identifier"
        },
        "provider": {
          "$ref": "#/$defs/identifier"
        },
        "model": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
