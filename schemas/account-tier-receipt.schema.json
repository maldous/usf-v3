{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:account-tier-receipt:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "routeMemberDigest",
    "accountSourceAuthorizationDigest",
    "accountSourceProtocolDigest",
    "endpointIdentity",
    "rawProviderResponseDigest",
    "authenticatedAccountIdentityDigest",
    "responseMappingDigest",
    "acquiredAt",
    "expiresAt",
    "tier",
    "paidUsageEnabled",
    "automaticOverageEnabled",
    "limit",
    "limitRemaining",
    "limitReset",
    "usage",
    "costDisposition",
    "verificationDisposition",
    "nonClaims"
  ],
  "properties": {
    "schema": { "const": "urn:usf:account-tier-receipt:1" },
    "version": { "const": 1 },
    "routeMemberDigest": { "$ref": "#/$defs/digest" },
    "accountSourceAuthorizationDigest": { "$ref": "#/$defs/digest" },
    "accountSourceProtocolDigest": { "$ref": "#/$defs/digest" },
    "endpointIdentity": {
      "type": "string",
      "minLength": 9,
      "pattern": "^https://"
    },
    "rawProviderResponseDigest": { "$ref": "#/$defs/digest" },
    "authenticatedAccountIdentityDigest": { "$ref": "#/$defs/digest" },
    "responseMappingDigest": { "$ref": "#/$defs/digest" },
    "acquiredAt": { "$ref": "#/$defs/instant" },
    "expiresAt": { "$ref": "#/$defs/instant" },
    "tier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._+:/-]{0,127}$"
    },
    "paidUsageEnabled": { "type": ["boolean", "null"] },
    "automaticOverageEnabled": { "type": ["boolean", "null"] },
    "limit": { "$ref": "#/$defs/decimalOrNull" },
    "limitRemaining": { "$ref": "#/$defs/decimalOrNull" },
    "limitReset": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        { "type": "null" }
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "daily",
        "weekly",
        "monthly",
        "byokTotal",
        "byokDaily",
        "byokWeekly",
        "byokMonthly",
        "byokIncludedInLimit",
        "paidCreditHistoryIndicator",
        "managementKey",
        "provisioningKey",
        "keyExpiresAt"
      ],
      "properties": {
        "total": { "$ref": "#/$defs/decimal" },
        "daily": { "$ref": "#/$defs/decimal" },
        "weekly": { "$ref": "#/$defs/decimal" },
        "monthly": { "$ref": "#/$defs/decimal" },
        "byokTotal": { "$ref": "#/$defs/decimal" },
        "byokDaily": { "$ref": "#/$defs/decimal" },
        "byokWeekly": { "$ref": "#/$defs/decimal" },
        "byokMonthly": { "$ref": "#/$defs/decimal" },
        "byokIncludedInLimit": { "type": "boolean" },
        "paidCreditHistoryIndicator": { "type": "boolean" },
        "managementKey": { "type": "boolean" },
        "provisioningKey": { "type": "boolean" },
        "keyExpiresAt": {
          "oneOf": [
            { "$ref": "#/$defs/instant" },
            { "type": "null" }
          ]
        }
      }
    },
    "costDisposition": {
      "enum": ["zero-paid", "paid", "unknown", "refused"]
    },
    "verificationDisposition": {
      "enum": ["verified", "stale", "mismatch", "untrusted", "refused"]
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "decimalOrNull": {
      "type": ["string", "null"],
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "decimal": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    }
  }
}
