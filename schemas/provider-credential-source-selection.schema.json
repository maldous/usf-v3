{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:provider-credential-source-selection:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "urn:usf:provider-credential-source-selection:1"
    },
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "iri": {
      "type": "string",
      "minLength": 5,
      "pattern": "^urn:[^<>\\s]+$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{0,191}$"
    },
    "credentialName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
    },
    "decimal": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]{1,95}(?::[^\\s]{1,192})?$"
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountSourceKeyDigest",
        "credentialMode",
        "credentialName",
        "envFilePath"
      ],
      "properties": {
        "accountSourceKeyDigest": {
          "$ref": "#/$defs/digest"
        },
        "credentialMode": {
          "enum": [
            "repository-env-file",
            "host-authenticated"
          ]
        },
        "credentialName": {
          "$ref": "#/$defs/credentialName"
        },
        "envFilePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\.usf/[A-Za-z0-9._/-]{1,191}$"
        }
      }
    }
  }
}
