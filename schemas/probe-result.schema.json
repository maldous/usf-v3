{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:probe-result:1",
  "type": "object",
  "required": ["schema", "status", "routeId", "endpointOrigin", "serviceTier", "requested", "inputs", "observedAt", "expiresAt", "capabilityEvaluations", "quota", "health", "cost", "usage", "latencyMs", "limits", "externalContact", "authorityEffect", "nonclaims", "resultDigest"],
  "properties": {
    "schema": {"const": "urn:usf:probe-result:1"}, "status": {"enum": ["ok", "failed"]}, "endpointOrigin": {"type": ["string", "null"], "enum": ["https://api.groq.com", "https://api.cerebras.ai", null]}, "serviceTier": {"enum": ["on_demand", "default", null]}, "reasonCode": {"enum": ["PROBE_ROUTE_UNSUPPORTED", "PROBE_CREDENTIAL_MISSING", "PROBE_INPUT_INVALID", "PROBE_COST_CLASS_INELIGIBLE", "PAID_FALLBACK_PROHIBITED", "ENTITLEMENT_UNVERIFIED", "ENTITLEMENT_EXPIRED", "ENTITLEMENT_QUOTA_UNKNOWN", "ENTITLEMENT_QUOTA_EXHAUSTED", "PROBE_MARKER_MISMATCH", "PROBE_ACTUAL_IDENTITY_MISMATCH", "PROBE_TIMEOUT", "PROBE_AUTHENTICATION_FAILED", "PROBE_RATE_LIMITED", "PROBE_PAYMENT_REQUIRED", "PROBE_COST_NONZERO", "PROBE_INVOCATION_FAILED"]}, "routeId": {"$ref": "#/$defs/label"},
    "requested": {"$ref": "#/$defs/identity"}, "actual": {"$ref": "#/$defs/actual"},
    "inputs": {"type": "object", "required": ["routeDigest", "adapterPackage", "adapterVersion", "adapterLockDigest", "catalogueRawDigest", "catalogueNormalizedDigest", "policyDigest", "entitlementEvidenceDigest", "probePromptDigest"], "properties": {"routeDigest": {"$ref": "#/$defs/digest"}, "adapterPackage": {"$ref": "#/$defs/adapter"}, "adapterVersion": {"$ref": "#/$defs/label"}, "adapterLockDigest": {"$ref": "#/$defs/digest"}, "catalogueRawDigest": {"$ref": "#/$defs/digest"}, "catalogueNormalizedDigest": {"$ref": "#/$defs/digest"}, "policyDigest": {"$ref": "#/$defs/digest"}, "entitlementEvidenceDigest": {"description": "Digest of internally verified raw zero-paid economics evidence; raw evidence is never emitted.", "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}, "probePromptDigest": {"$ref": "#/$defs/digest"}}, "additionalProperties": false},
    "observedAt": {"$ref": "#/$defs/instant"}, "expiresAt": {"$ref": "#/$defs/instant"}, "capabilityEvaluations": {"type": "array", "items": {"$ref": "#/$defs/capabilityEvaluation"}}, "quota": {"enum": ["available", "exhausted", "unknown"]}, "health": {"enum": ["available", "unavailable", "unknown"]},
    "cost": {"type": "object", "required": ["observedCost", "currency", "evidence"], "properties": {"observedCost": {"type": ["number", "null"], "minimum": 0}, "currency": {"enum": ["USD", null]}, "evidence": {"enum": ["provider-reported", "entitlement", "unavailable"]}}, "additionalProperties": false},
    "usage": {"type": "object", "required": ["inputTokens", "outputTokens"], "properties": {"inputTokens": {"type": ["integer", "null"], "minimum": 0}, "outputTokens": {"type": ["integer", "null"], "minimum": 0}}, "additionalProperties": false},
    "latencyMs": {"type": ["number", "null"], "minimum": 0, "maximum": 30000},
    "limits": {"type": "object", "required": ["timeoutMs", "maxRetries", "maxOutputTokens"], "properties": {"timeoutMs": {"type": "integer", "minimum": 1, "maximum": 30000}, "maxRetries": {"const": 0}, "maxOutputTokens": {"const": 8}}, "additionalProperties": false},
    "externalContact": {"type": "boolean"}, "authorityEffect": {"const": "none"}, "nonclaims": {"type": "array", "items": {"type": "string"}}, "resultDigest": {"$ref": "#/$defs/digest"}
  }, "additionalProperties": false,
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "label": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+~-]{0,191}$"}, "adapter": {"type": "string", "pattern": "^(?:@[a-z0-9][a-z0-9._-]{0,63}/)?[a-z0-9][a-z0-9._-]{0,95}$"}, "instant": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"}, "identity": {"type": "object", "required": ["family", "provider", "model"], "properties": {"family": {"$ref": "#/$defs/label"}, "provider": {"$ref": "#/$defs/label"}, "model": {"$ref": "#/$defs/label"}}, "additionalProperties": false}, "actual": {"type": "object", "required": ["family", "provider", "model", "sdkProvider"], "properties": {"family": {"$ref": "#/$defs/label"}, "provider": {"$ref": "#/$defs/label"}, "model": {"$ref": "#/$defs/label"}, "sdkProvider": {"type": ["string", "null"]}}, "additionalProperties": false}, "capabilityEvaluation": {"type": "object", "required": ["capability", "status", "reasonCode"], "properties": {"capability": {"const": "text-generation"}, "status": {"enum": ["available", "unavailable", "unknown"]}, "reasonCode": {"type": ["string", "null"]}}, "additionalProperties": false}}
}
