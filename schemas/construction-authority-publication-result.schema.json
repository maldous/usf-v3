{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:construction-authority-publication-result:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "operation", "mode", "publicationState", "publicationReceiptPath", "receiptDigest", "baseSemanticDigest", "resultingSemanticDigest", "memberCount", "authorityEffect", "nonClaims"],
  "properties": {
    "schema": {"const": "urn:usf:construction-authority-publication-result:1"},
    "status": {"const": "ok"},
    "operation": {"const": "construction-authority"},
    "mode": {"enum": ["verify", "apply"]},
    "publicationState": {"enum": ["verified-without-publication", "created", "matching"]},
    "publicationReceiptPath": {"type": "string", "pattern": "^evidence/construction-authority/[0-9a-f]{64}\\.json$"},
    "receiptDigest": {"$ref": "#/$defs/digest"},
    "baseSemanticDigest": {"$ref": "#/$defs/digest"},
    "resultingSemanticDigest": {"$ref": "#/$defs/digest"},
    "memberCount": {"type": "integer", "minimum": 1, "maximum": 32},
    "authorityEffect": {"enum": ["verified-without-publication", "copy-on-write-construction-authority-created", "existing-copy-on-write-construction-authority-authenticated"]},
    "nonClaims": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}}
  },
  "oneOf": [
    {"properties": {"mode": {"const": "verify"}, "publicationState": {"const": "verified-without-publication"}, "authorityEffect": {"const": "verified-without-publication"}}},
    {"properties": {"mode": {"const": "apply"}, "publicationState": {"const": "created"}, "authorityEffect": {"const": "copy-on-write-construction-authority-created"}}},
    {"properties": {"mode": {"const": "apply"}, "publicationState": {"const": "matching"}, "authorityEffect": {"const": "existing-copy-on-write-construction-authority-authenticated"}}}
  ],
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
