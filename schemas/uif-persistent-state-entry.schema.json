{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uif:schema:persistent-state-entry:2",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "stateClass",
        "owner",
        "applicability",
        "retention",
        "restore",
        "backup"
      ],
      "properties": {
        "stateClass": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "const": "applicable"
        },
        "retention": {
          "type": "string",
          "minLength": 1
        },
        "restore": {
          "type": "string",
          "minLength": 1
        },
        "backup": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "stateClass",
        "owner",
        "applicability",
        "reason"
      ],
      "properties": {
        "stateClass": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "const": "inapplicable"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  ]
}
