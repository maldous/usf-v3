{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:candidate:1",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "status",
    "basis",
    "identity",
    "payload",
    "lineage"
  ],
  "properties": {
    "schema": {
      "const": "urn:usf:candidate:1"
    },
    "kind": {
      "const": "candidate"
    },
    "status": {
      "const": "resolved"
    },
    "basis": {
      "type": "object"
    },
    "identity": {
      "type": "object",
      "required": [
        "artifactDigest",
        "basisDigest"
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "operations"
      ]
    },
    "lineage": {
      "type": "object",
      "required": [
        "acceptedContributionDigests",
        "rejected"
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "fileMode": {
      "enum": [
        "100644",
        "100755"
      ]
    },
    "registrationFeatureOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "contentDigest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "write",
            "delete"
          ]
        },
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "contentDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "registrationFeaturePostimage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "resultingMode",
        "resultingContentDigest"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "write",
                "delete"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "resultingMode": {
          "anyOf": [
            {
              "$ref": "#/$defs/fileMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "resultingContentDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
