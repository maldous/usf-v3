{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:provider-host-source-identity:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "accountSourceKeyDigest",
    "sourceKind",
    "transport",
    "provider",
    "mappingDigest",
    "credentialMode",
    "credentialFileIdentityDigest",
    "executableIdentityDigest",
    "authenticationModeDigest",
    "credentialSourceIdentityDigest",
    "observedAt",
    "disposition",
    "nonClaims"
  ],
  "properties": {
    "schema": {
      "const": "urn:usf:provider-host-source-identity:1"
    },
    "version": {
      "const": 1
    },
    "accountSourceKeyDigest": {
      "$ref": "#/$defs/digest"
    },
    "sourceKind": {
      "const": "subscription-host"
    },
    "transport": {
      "enum": [
        "direct-sdk",
        "openrouter",
        "codex-cli",
        "claude-cli"
      ]
    },
    "provider": {
      "$ref": "#/$defs/identifier"
    },
    "mappingDigest": {
      "$ref": "#/$defs/digest"
    },
    "credentialMode": {
      "const": "host-authenticated"
    },
    "credentialFileIdentityDigest": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "executableIdentityDigest": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "authenticationModeDigest": {
      "$ref": "#/$defs/digest"
    },
    "credentialSourceIdentityDigest": {
      "$ref": "#/$defs/digest"
    },
    "observedAt": {
      "$ref": "#/$defs/instant"
    },
    "disposition": {
      "enum": [
        "stable",
        "unstable",
        "unavailable",
        "refused"
      ]
    },
    "nonClaims": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "iri": {
      "type": "string",
      "minLength": 5,
      "pattern": "^urn:[^<>\\s]+$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{0,191}$"
    },
    "credentialName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
    },
    "decimal": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]{1,95}(?::[^\\s]{1,192})?$"
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  }
}
