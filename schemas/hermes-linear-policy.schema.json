{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:schema:hermes-linear-policy:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "endpoint",
    "pageSize",
    "maxPages",
    "timeoutMs",
    "maxResponseBytes",
    "maximumIssuesPerCycle",
    "pollSeconds",
    "allowCreate",
    "allowUpdate",
    "bindingManifests",
    "workspaces"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "urn:usf:hermes-linear-policy:1" },
    "endpoint": { "const": "https://api.linear.app/graphql" },
    "maxPages": { "type": "integer", "minimum": 1, "maximum": 20 },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 30000 },
    "maxResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 4194304 },
    "pageSize": { "type": "integer", "minimum": 1, "maximum": 50 },
    "maximumIssuesPerCycle": { "type": "integer", "minimum": 1, "maximum": 100 },
    "pollSeconds": { "type": "integer", "minimum": 5, "maximum": 3600 },
    "allowCreate": { "type": "boolean" },
    "allowUpdate": { "type": "boolean" },
    "bindingManifests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^graph/manifests/[A-Za-z0-9._-]+\\.json$" }
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "organizationUrlKey", "credentialName", "authScheme", "teams"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" },
          "organizationUrlKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "credentialName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
          "authScheme": { "enum": ["api-key", "bearer"] },
          "teams": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "owner", "assigneeId", "startedStateId", "completedStateId", "blockedStateId"],
              "properties": {
                "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
                "owner": { "enum": ["USF", "UIF", "UXF", "ANQR"] },
                "assigneeId": { "type": ["string", "null"], "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
                "startedStateId": { "type": ["string", "null"], "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
                "completedStateId": { "type": ["string", "null"], "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
                "blockedStateId": { "type": ["string", "null"], "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
              }
            }
          }
        }
      }
    }
  }
}
