{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:usf:semantic-qualification-result:1",
 "type": "object",
 "required": [
  "schema",
  "status",
  "taskClass",
  "profile",
  "inputs",
  "caseEvaluations",
  "dimensionEvaluations",
  "taskScore",
  "casesAnswered",
  "casesPassed",
  "casesTotal",
  "defects",
  "derivedRoles",
  "observedAt",
  "evaluatedAt",
  "validUntil",
  "externalContact",
  "authorityEffect",
  "nonclaims",
  "qualificationDigest"
 ],
 "properties": {
  "schema": {
   "const": "urn:usf:semantic-qualification-result:1"
  },
  "status": {
   "enum": [
    "qualified",
    "unqualified"
   ]
  },
  "taskClass": {
   "$ref": "#/$defs/label"
  },
  "profile": {
   "type": "object",
   "required": [
    "profileDigest",
    "requested",
    "actual"
   ],
   "properties": {
    "profileDigest": {
     "$ref": "#/$defs/digest"
    },
    "requested": {
     "type": "object",
     "required": [
      "provider",
      "model",
      "adapter",
      "adapterVersion",
      "adapterLockDigest",
      "authMode",
      "toolProfile",
      "toolProfileDigest",
      "promptVersion",
      "promptDigest",
      "contextConfig",
      "contextConfigDigest",
      "outputConfig",
      "outputConfigDigest"
     ],
     "properties": {
      "provider": {
       "$ref": "#/$defs/label"
      },
      "model": {
       "$ref": "#/$defs/label"
      },
      "adapter": {
       "anyOf": [
        {
         "$ref": "#/$defs/adapter"
        },
        {
         "type": "null"
        }
       ]
      },
      "adapterVersion": {
       "anyOf": [
        {
         "$ref": "#/$defs/label"
        },
        {
         "type": "null"
        }
       ]
      },
      "adapterLockDigest": {
       "anyOf": [
        {
         "$ref": "#/$defs/digest"
        },
        {
         "type": "null"
        }
       ]
      },
      "authMode": {
       "enum": [
        "api_token",
        "oidc_cli",
        "local",
        "none"
       ]
      },
      "toolProfile": {
       "$ref": "#/$defs/label"
      },
      "toolProfileDigest": {
       "$ref": "#/$defs/digest"
      },
      "promptVersion": {
       "$ref": "#/$defs/label"
      },
      "promptDigest": {
       "$ref": "#/$defs/digest"
      },
      "contextConfig": {
       "$ref": "#/$defs/label"
      },
      "contextConfigDigest": {
       "$ref": "#/$defs/digest"
      },
      "outputConfig": {
       "$ref": "#/$defs/label"
      },
      "outputConfigDigest": {
       "$ref": "#/$defs/digest"
      }
     },
     "additionalProperties": false
    },
    "actual": {
     "type": "object",
     "required": [
      "provider",
      "model",
      "transport"
     ],
     "properties": {
      "provider": {
       "$ref": "#/$defs/label"
      },
      "model": {
       "anyOf": [
        {
         "$ref": "#/$defs/label"
        },
        {
         "type": "null"
        }
       ]
      },
      "transport": {
       "$ref": "#/$defs/label"
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "inputs": {
   "type": "object",
   "required": [
    "suiteDigest",
    "corpusDigest",
    "qualificationPolicyDigest",
    "effectivePolicyDigest",
    "observationSetDigest"
   ],
   "properties": {
    "suiteDigest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "corpusDigest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "qualificationPolicyDigest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "effectivePolicyDigest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observationSetDigest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    }
   },
   "additionalProperties": false
  },
  "caseEvaluations": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/caseEvaluation"
   }
  },
  "dimensionEvaluations": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/dimensionEvaluation"
   }
  },
  "taskScore": {
   "$ref": "#/$defs/score"
  },
  "casesAnswered": {
   "$ref": "#/$defs/count"
  },
  "casesPassed": {
   "$ref": "#/$defs/count"
  },
  "casesTotal": {
   "$ref": "#/$defs/count"
  },
  "derivedRoles": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/role"
   }
  },
  "observedAt": {
   "$ref": "#/$defs/instant"
  },
  "evaluatedAt": {
   "$ref": "#/$defs/instant"
  },
  "validUntil": {
   "$ref": "#/$defs/instant"
  },
  "externalContact": {
   "const": false
  },
  "authorityEffect": {
   "const": "none"
  },
  "nonclaims": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "qualificationDigest": {
   "$ref": "#/$defs/digest"
  },
  "defects": {
   "$ref": "#/$defs/defectSummary"
  }
 },
 "additionalProperties": false,
 "$defs": {
  "digest": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "instant": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
  },
  "label": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+~-]{0,191}$"
  },
  "adapter": {
   "type": "string",
   "pattern": "^(?:@[a-z0-9][a-z0-9._-]{0,63}/)?[a-z0-9][a-z0-9._-]{0,95}$"
  },
  "score": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "count": {
   "type": "integer",
   "minimum": 0,
   "maximum": 10000
  },
  "weight": {
   "type": "number",
   "minimum": 0,
   "maximum": 1000
  },
  "dimension": {
   "enum": [
    "semantic_planning",
    "rdf_owl_reasoning",
    "shacl_sparql",
    "repository_navigation",
    "implementation",
    "debugging",
    "tool_selection",
    "structured_output",
    "scope_discipline",
    "evidence_discipline",
    "uncertainty_handling",
    "review",
    "wave_integration",
    "latency",
    "cost",
    "false_completion",
    "later_regression"
   ]
  },
  "role": {
   "enum": [
    "UNQUALIFIED",
    "READ_ONLY_ANALYST",
    "PLANNER_CANDIDATE",
    "PATCH_PRODUCER",
    "REVIEWER",
    "INTEGRATOR",
    "ADJUDICATOR",
    "TRUSTED_COORDINATOR"
   ]
  },
  "caseEvaluation": {
   "type": "object",
   "required": [
    "caseId",
    "taskClass",
    "dimension",
    "answerPresent",
    "score",
    "weight",
    "passed",
    "verdict",
    "graderKind",
    "judgementMode",
    "diagnostic"
   ],
   "properties": {
    "caseId": {
     "$ref": "#/$defs/label"
    },
    "taskClass": {
     "$ref": "#/$defs/label"
    },
    "dimension": {
     "$ref": "#/$defs/dimension"
    },
    "answerPresent": {
     "type": "boolean"
    },
    "score": {
     "$ref": "#/$defs/score"
    },
    "weight": {
     "$ref": "#/$defs/weight"
    },
    "passed": {
     "type": "boolean"
    },
    "verdict": {
     "enum": [
      "PASS",
      "FAIL",
      "REFUSAL",
      "INAPPLICABLE",
      "INSUFFICIENT_EVIDENCE"
     ]
    },
    "graderKind": {
     "enum": [
      "exact",
      "contains",
      "not-contains",
      "regex",
      "iri-exact",
      "choice",
      "set-equal",
      "json-schema",
      "uncertainty"
     ]
    },
    "judgementMode": {
     "enum": [
      "comparison",
      "structural-validation",
      "marker-detection",
      "selection"
     ]
    },
    "diagnostic": {
     "enum": [
      "ANSWER_MATCHED_EXPECTATION",
      "ANSWER_DID_NOT_MATCH_EXPECTATION",
      "ANSWER_WAS_A_REFUSAL",
      "ANSWER_ABSENT",
      "ANSWER_NOT_BOUND_TO_THIS_CASE",
      "ANSWER_ALREADY_EVIDENCED_ANOTHER_CASE",
      "GRADER_NOT_COMPETENT_FOR_DIMENSION"
     ]
    }
   },
   "additionalProperties": false
  },
  "dimensionEvaluation": {
   "type": "object",
   "required": [
    "taskClass",
    "dimension",
    "score",
    "answered",
    "passed",
    "total"
   ],
   "properties": {
    "taskClass": {
     "$ref": "#/$defs/label"
    },
    "dimension": {
     "$ref": "#/$defs/dimension"
    },
    "score": {
     "$ref": "#/$defs/score"
    },
    "answered": {
     "$ref": "#/$defs/count"
    },
    "passed": {
     "$ref": "#/$defs/count"
    },
    "total": {
     "$ref": "#/$defs/count"
    }
   },
   "additionalProperties": false
  },
  "defectSummary": {
   "type": "object",
   "required": [
    "implementationDefect",
    "evidenceDefect",
    "refusal",
    "graderIncapability",
    "manufacturedEvidence",
    "attributableToModel"
   ],
   "properties": {
    "implementationDefect": {
     "type": "integer",
     "minimum": 0
    },
    "evidenceDefect": {
     "type": "integer",
     "minimum": 0
    },
    "refusal": {
     "type": "integer",
     "minimum": 0
    },
    "graderIncapability": {
     "type": "integer",
     "minimum": 0
    },
    "manufacturedEvidence": {
     "type": "integer",
     "minimum": 0
    },
    "attributableToModel": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  }
 }
}
