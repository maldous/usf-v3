{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:profile-scoped-construction-authority-publication-receipt:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "algorithmIri", "algorithmVersion", "algorithmResourceDigest", "publicationPolicyIri", "publicationPolicyDigest", "publicationIntentDigest", "targetGraphIri", "semanticSourcePath", "publicationReceiptPath", "profileIri", "profileVersion", "manifestPath", "manifestDigest", "baseSourceDigest", "resultingSourceDigest", "baseSemanticDigest", "resultingSemanticDigest", "memberCount", "members", "operations", "deltaDigest", "validationResultDigest", "nonClaims", "receiptDigest"],
  "properties": {
    "schema": {"enum": ["urn:usf:construction-authority-publication-receipt:1", "urn:usf:profile-scoped-construction-authority-publication-receipt:1"]},
    "status": {"const": "verified"},
    "algorithmIri": {"$ref": "#/$defs/iri"},
    "algorithmVersion": {"const": "1"},
    "algorithmResourceDigest": {"$ref": "#/$defs/digest"},
    "publicationPolicyIri": {"$ref": "#/$defs/iri"},
    "publicationPolicyDigest": {"$ref": "#/$defs/digest"},
    "publicationIntentDigest": {"$ref": "#/$defs/digest"},
    "targetGraphIri": {"$ref": "#/$defs/iri"},
    "semanticSourcePath": {"$ref": "#/$defs/path"},
    "publicationReceiptPath": {"type": "string", "pattern": "^evidence/construction-authority/[0-9a-f]{64}\\.json$"},
    "profileIri": {"$ref": "#/$defs/iri"},
    "profileVersion": {"$ref": "#/$defs/version"},
    "manifestPath": {"$ref": "#/$defs/path"},
    "manifestDigest": {"$ref": "#/$defs/digest"},
    "baseSourceDigest": {"$ref": "#/$defs/digest"},
    "resultingSourceDigest": {"$ref": "#/$defs/digest"},
    "baseSemanticDigest": {"$ref": "#/$defs/digest"},
    "resultingSemanticDigest": {"$ref": "#/$defs/digest"},
    "memberCount": {"type": "integer", "minimum": 1, "maximum": 32},
    "members": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/member"}},
    "operations": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/operation"}},
    "deltaDigest": {"$ref": "#/$defs/digest"},
    "validationResultDigest": {"$ref": "#/$defs/digest"},
    "nonClaims": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "iri": {"type": "string", "pattern": "^urn:[^<>\\s]+$"},
    "path": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "workIri", "permissionIri", "maximumThrough", "authorityBasisDigest", "evidenceIri", "evidenceDigest", "proofResultIri", "proofDigest", "grantIri", "grantDigest", "publicationIntentDigest"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 32},
        "workIri": {"$ref": "#/$defs/iri"},
        "permissionIri": {"$ref": "#/$defs/iri"},
        "maximumThrough": {"enum": ["work", "route", "call", "resolve", "apply", "check", "integrate", "publish", "runtime"]},
        "authorityBasisDigest": {"$ref": "#/$defs/digest"},
        "evidenceIri": {"$ref": "#/$defs/iri"},
        "evidenceDigest": {"$ref": "#/$defs/digest"},
        "proofResultIri": {"$ref": "#/$defs/iri"},
        "proofDigest": {"$ref": "#/$defs/digest"},
        "grantIri": {"$ref": "#/$defs/iri"},
        "grantDigest": {"$ref": "#/$defs/digest"},
        "publicationIntentDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "kind", "sourcePath", "line"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 1024},
        "kind": {"const": "add"},
        "sourcePath": {"$ref": "#/$defs/path"},
        "line": {"type": "string", "minLength": 1}
      }
    }
  }
}
