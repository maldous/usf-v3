{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:semantic-recovery:1",
  "type": "object",
  "required": ["schema", "version", "sourceSetDigest", "inventoryDigest", "exactDispositions", "rules", "readinessRecords", "reviewedMappings", "recoveryDigest"],
  "properties": {
    "schema": { "const": "urn:usf:semantic-recovery:1" },
    "version": { "const": 1 },
    "sourceSetDigest": { "$ref": "#/$defs/digest" },
    "inventoryDigest": { "$ref": "#/$defs/digest" },
    "exactDispositions": { "type": "array", "items": { "$ref": "#/$defs/exactDisposition" } },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "readinessRecords": { "type": "array", "items": { "$ref": "#/$defs/readiness" } },
    "reviewedMappings": { "type": "array", "items": { "$ref": "#/$defs/mapping" } },
    "recoveryDigest": { "$ref": "#/$defs/digest" }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "iri": { "type": "string", "pattern": "^(?:urn:[^<>\\s]+|https?://[^<>\\s]+)$" },
    "label": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positiveCount": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "nonnegative": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
    "candidateKind": {
      "enum": ["tracked-source-artifact", "graph-selection", "named-semantic-resource", "rdf-type-assertion", "predicate-vocabulary", "referenced-iri", "structured-schema-or-registry-record", "test-obligation", "semantic-document"]
    },
    "resolution": {
      "type": "object",
      "required": ["disposition", "rationale", "targetV3Iri", "definitionCoverageState", "operationalImplementationState", "readinessRecordDigest"],
      "properties": {
        "disposition": { "enum": ["re-express-ready", "metadata-only", "defer", "not-claimed", "historical-only", "reject", "unresolved"] },
        "rationale": { "$ref": "#/$defs/label" },
        "targetV3Iri": { "oneOf": [{ "$ref": "#/$defs/iri" }, { "type": "null" }] },
        "definitionCoverageState": { "enum": ["covered", "partial", "absent", "unknown"] },
        "operationalImplementationState": { "enum": ["implemented", "partial", "not-implemented", "not-applicable", "unknown"] },
        "readinessRecordDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["reviewId", "reviewDigest"],
      "properties": {
        "reviewId": { "$ref": "#/$defs/label" },
        "reviewDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "exactDisposition": {
      "type": "object",
      "required": ["candidateId", "resolution", "provenance"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/digest" },
        "resolution": { "$ref": "#/$defs/resolution" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },
    "match": {
      "oneOf": [
        {
          "type": "object",
          "required": ["sourceId", "candidateKind"],
          "properties": {
            "sourceId": { "$ref": "#/$defs/iri" },
            "candidateKind": { "$ref": "#/$defs/candidateKind" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["sourceId", "candidateKind", "exactType"],
          "properties": {
            "sourceId": { "$ref": "#/$defs/iri" },
            "candidateKind": { "$ref": "#/$defs/candidateKind" },
            "exactType": { "$ref": "#/$defs/iri" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["sourceId", "candidateKind", "predicate"],
          "properties": {
            "sourceId": { "$ref": "#/$defs/iri" },
            "candidateKind": { "$ref": "#/$defs/candidateKind" },
            "predicate": { "$ref": "#/$defs/iri" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["sourceId", "candidateKind", "pathClass"],
          "properties": {
            "sourceId": { "$ref": "#/$defs/iri" },
            "candidateKind": { "$ref": "#/$defs/candidateKind" },
            "pathClass": { "$ref": "#/$defs/label" }
          },
          "additionalProperties": false
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": ["id", "match", "resolution", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/label" },
        "match": { "$ref": "#/$defs/match" },
        "resolution": { "$ref": "#/$defs/resolution" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },
    "relevance": {
      "type": "object",
      "required": ["consumerIri", "consumerKind", "consumerDigest", "unsatisfied", "duplicate"],
      "properties": {
        "consumerIri": { "$ref": "#/$defs/iri" },
        "consumerKind": { "enum": ["contract", "requirement", "consumer"] },
        "consumerDigest": { "$ref": "#/$defs/digest" },
        "unsatisfied": { "const": true },
        "duplicate": { "const": false }
      },
      "additionalProperties": false
    },
    "connectivity": {
      "type": "object",
      "required": ["status", "selectedProfileIri", "selectedProfileVersion", "closureDigest", "targetIri", "relationType", "intendedConsumers", "newRootExceptionDigest"],
      "properties": {
        "status": { "enum": ["connected", "accepted-new-root", "disconnected", "unknown"] },
        "selectedProfileIri": { "$ref": "#/$defs/iri" },
        "selectedProfileVersion": { "$ref": "#/$defs/label" },
        "closureDigest": { "$ref": "#/$defs/digest" },
        "targetIri": { "$ref": "#/$defs/iri" },
        "relationType": { "$ref": "#/$defs/label" },
        "intendedConsumers": { "type": "array", "items": { "$ref": "#/$defs/iri" } },
        "newRootExceptionDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "licence": {
      "type": "object",
      "required": ["status", "decisionDigest"],
      "properties": {
        "status": { "enum": ["cleared", "restricted", "unknown"] },
        "decisionDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "layer": {
      "type": "object",
      "required": ["targetLayer", "productProfileIri", "productProfileVersion", "isolationStatus", "decisionDigest"],
      "properties": {
        "targetLayer": { "enum": ["core", "product"] },
        "productProfileIri": { "oneOf": [{ "$ref": "#/$defs/iri" }, { "type": "null" }] },
        "productProfileVersion": { "oneOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] },
        "isolationStatus": { "enum": ["cleared", "violated", "unknown"] },
        "decisionDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "mitigation": {
      "type": "object",
      "required": ["lessonId", "mitigation", "verificationDigest"],
      "properties": {
        "lessonId": { "$ref": "#/$defs/label" },
        "mitigation": { "$ref": "#/$defs/label" },
        "verificationDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "currentness": {
      "type": "object",
      "required": ["sourceSetDigest", "inventoryDigest", "selectedProfileIri", "selectedProfileVersion", "semanticDigest", "closureDigest", "validationObligationDigest", "testObligationDigest"],
      "properties": {
        "sourceSetDigest": { "$ref": "#/$defs/digest" },
        "inventoryDigest": { "$ref": "#/$defs/digest" },
        "selectedProfileIri": { "$ref": "#/$defs/iri" },
        "selectedProfileVersion": { "$ref": "#/$defs/label" },
        "semanticDigest": { "$ref": "#/$defs/digest" },
        "closureDigest": { "$ref": "#/$defs/digest" },
        "validationObligationDigest": { "$ref": "#/$defs/digest" },
        "testObligationDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "bau": {
      "type": "object",
      "required": ["dimension", "ceiling", "observed", "unit", "status"],
      "properties": {
        "dimension": { "enum": ["authority-dependencies", "storage-dependencies", "network-use", "provider-use", "update-triggers", "scan-bytes", "scan-runtime-ms", "memory-bytes", "test-runtime-ms", "maintenance-cost", "failure-scope", "rollback-cost", "retirement-cost"] },
        "ceiling": { "$ref": "#/$defs/nonnegative" },
        "observed": { "$ref": "#/$defs/nonnegative" },
        "unit": { "$ref": "#/$defs/label" },
        "status": { "enum": ["within", "over", "unknown"] }
      },
      "additionalProperties": false
    },
    "lifecycleNotApplicable": {
      "type": "object",
      "required": ["applicability", "rationale"],
      "properties": {
        "applicability": { "const": "not-applicable" },
        "rationale": { "$ref": "#/$defs/label" }
      },
      "additionalProperties": false
    },
    "lifecycleUnknown": {
      "type": "object",
      "required": ["applicability", "rationale"],
      "properties": {
        "applicability": { "const": "unknown" },
        "rationale": { "$ref": "#/$defs/label" }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "required": ["start", "status", "stop"],
      "properties": {
        "start": { "const": true },
        "status": { "const": true },
        "stop": { "const": true }
      },
      "additionalProperties": false
    },
    "lifecycleApplicable": {
      "type": "object",
      "required": ["applicability", "rationale", "commands", "retryBound", "drainMilliseconds", "restartBound", "noPartialAuthorityMutation"],
      "properties": {
        "applicability": { "const": "applicable" },
        "rationale": { "$ref": "#/$defs/label" },
        "commands": { "$ref": "#/$defs/commands" },
        "retryBound": { "$ref": "#/$defs/positiveCount" },
        "drainMilliseconds": { "$ref": "#/$defs/positiveCount" },
        "restartBound": { "$ref": "#/$defs/positiveCount" },
        "noPartialAuthorityMutation": { "const": true }
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": ["schema", "candidateId", "sourceDigest", "reviewed", "reviewDigest", "relevance", "connectivity", "licence", "layer", "mitigations", "currentness", "bauCeilings", "lifecycle", "readinessDigest"],
      "properties": {
        "schema": { "const": "urn:usf:semantic-adoption-readiness:1" },
        "candidateId": { "$ref": "#/$defs/digest" },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "reviewed": { "const": true },
        "reviewDigest": { "$ref": "#/$defs/digest" },
        "relevance": { "$ref": "#/$defs/relevance" },
        "connectivity": { "$ref": "#/$defs/connectivity" },
        "licence": { "$ref": "#/$defs/licence" },
        "layer": { "$ref": "#/$defs/layer" },
        "mitigations": { "type": "array", "items": { "$ref": "#/$defs/mitigation" } },
        "currentness": { "$ref": "#/$defs/currentness" },
        "bauCeilings": { "type": "array", "items": { "$ref": "#/$defs/bau" } },
        "lifecycle": { "oneOf": [{ "$ref": "#/$defs/lifecycleNotApplicable" }, { "$ref": "#/$defs/lifecycleApplicable" }, { "$ref": "#/$defs/lifecycleUnknown" }] },
        "readinessDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "required": ["id", "kind", "sourceCandidateIds", "targetV3Iris", "reviewDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/label" },
        "kind": { "enum": ["split", "merge", "equivalent", "replacement"] },
        "sourceCandidateIds": { "type": "array", "items": { "$ref": "#/$defs/digest" } },
        "targetV3Iris": { "type": "array", "items": { "$ref": "#/$defs/iri" } },
        "reviewDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}
