{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:bootstrap-carrier-result:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "operation", "mode", "carrierAdoptionIri", "authorityProfileIri", "authorityManifestPath", "localPreparationReceiptPath", "trackedReceiptPath", "trackedReceiptState", "receiptDigest", "historicalObservedCurrentnessDisposition", "liveCurrentnessBasisCommit", "liveCurrentnessBasisTree", "liveCurrentnessDisposition", "authorityEffect", "nonClaims", "completionState", "evidenceState", "proofState", "ordinaryPermissionState", "runtimeState"],
  "properties": {
    "schema": {"const": "urn:usf:bootstrap-carrier-result:1"},
    "status": {"const": "ok"},
    "operation": {"const": "bootstrap-carrier"},
    "mode": {"enum": ["verify", "adopt"]},
    "carrierAdoptionIri": {"$ref": "#/$defs/iri"},
    "authorityProfileIri": {"$ref": "#/$defs/iri"},
    "authorityManifestPath": {"const": "graph/manifests/integration.json"},
    "localPreparationReceiptPath": {"type": "string", "pattern": "^\\.usf/receipts/bootstrap-carrier/[A-Za-z0-9._-]+\\.json$"},
    "trackedReceiptPath": {"type": "string", "pattern": "^evidence/historical-carriers/[A-Za-z0-9._-]+\\.json$"},
    "trackedReceiptState": {"enum": ["absent", "created", "matching"]},
    "receiptDigest": {"$ref": "#/$defs/digest"},
    "historicalObservedCurrentnessDisposition": {"enum": ["current", "reconstructable"]},
    "liveCurrentnessBasisCommit": {"$ref": "#/$defs/gitObject"},
    "liveCurrentnessBasisTree": {"$ref": "#/$defs/gitObject"},
    "liveCurrentnessDisposition": {"enum": ["current", "reconstructable"]},
    "authorityEffect": {"enum": ["verified-without-publication", "historical-carrier-observation-created", "existing-historical-carrier-observation-authenticated"]},
    "nonClaims": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "completionState": {"const": "not-observed"},
    "evidenceState": {"const": "not-admitted"},
    "proofState": {"const": "not-evaluated"},
    "ordinaryPermissionState": {"const": "unchanged"},
    "runtimeState": {"const": "unchanged"}
  },
  "oneOf": [
    {"properties": {"mode": {"const": "verify"}, "trackedReceiptState": {"enum": ["absent", "matching"]}}},
    {"properties": {"mode": {"const": "adopt"}, "trackedReceiptState": {"enum": ["created", "matching"]}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "iri": {"type": "string", "pattern": "^urn:[^<>\\s]+$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
