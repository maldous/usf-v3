{
  "$defs": {
    "parallelSafetyBasis": {
      "additionalProperties": false,
      "properties": {
        "assessedPairCount": {
          "description": "Count of distinct authenticated pair assessments; compare with exact required pair identities.",
          "maximum": 1048576,
          "minimum": 0,
          "type": "integer"
        },
        "currentnessRule": {
          "description": "Admitted evaluator of semantic/runtime currentness and evidence scope.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        },
        "obligations": {
          "description": "Complete semantic safety obligations, including evidence and interruption/recovery dependencies.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "realisationBasis": {
          "description": "Exact immutable RealisationBasis authenticated independently against current selected work.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        },
        "requiredPairCount": {
          "description": "Required concurrent-pair denominator derived from current cohort and admitted dependency rules.",
          "maximum": 1048576,
          "minimum": 0,
          "type": "integer"
        },
        "resourceDigest": {
          "description": "Digest of shared authority, integration, provider/account and Linear concurrency resources.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        },
        "scopeDigest": {
          "description": "Digest of normalized cohort read/write scopes; no path-name inference.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        },
        "semanticDigest": {
          "description": "Exact current semantic closure digest and declared digest domain.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        },
        "verificationEvidence": {
          "description": "Current independent verification evidence with original lineage and scope.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "verifier": {
          "description": "Independent admitted verifier identity; a declared identity alone does not establish independence.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        }
      },
      "required": [
        "assessedPairCount",
        "currentnessRule",
        "obligations",
        "realisationBasis",
        "requiredPairCount",
        "resourceDigest",
        "scopeDigest",
        "semanticDigest",
        "verificationEvidence",
        "verifier"
      ],
      "type": "object"
    },
    "parallelSafetyBlocked": {
      "additionalProperties": false,
      "properties": {
        "assessmentRule": {
          "description": "Graph-owned assessment and currentness rule, not a caller-selected workflow.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        },
        "conflicts": {
          "description": "Observed resource or semantic conflicts; an empty list is not proof of compatibility.",
          "items": {
            "$ref": "#/$defs/parallelSafetyConflict"
          },
          "maxItems": 1024,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "evidence": {
          "description": "Original observed evidence identities, preserved even when stale or rejected.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "members": {
          "description": "Exact transition cohort assessed; completeness requires the current semantic member denominator.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "missingObligations": {
          "description": "Unfulfilled or stale assessment obligations remain explicit.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "reasonCodes": {
          "description": "Explicit conflict, stale evidence, or verification failure reasons.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "semanticBasis": {
          "description": "Exact observed semantic closure digest in its SHA-256 domain; structural validity does not authenticate currentness.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        },
        "state": {
          "const": "blocked",
          "description": "Assessment classification only; the proved tag never authenticates its own claim.",
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "assessmentRule",
        "conflicts",
        "evidence",
        "members",
        "missingObligations",
        "reasonCodes",
        "semanticBasis",
        "state"
      ],
      "type": "object"
    },
    "parallelSafetyConflict": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "description": "Original observation/evidence identities supporting the conflict.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "kind": {
          "description": "Typed conflict domain, not a free-form operational fields map.",
          "enum": [
            "evidence-dependency",
            "integration-ownership",
            "linear-serialization",
            "path-overlap",
            "provider-capacity",
            "recovery-constraint",
            "shared-authority",
            "unknown"
          ],
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "left": {
          "description": "Exact left member involved in this conflict.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        },
        "resource": {
          "description": "Exact canonical resource identity or repository path implicated by the conflict rule.",
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "right": {
          "description": "Exact right member involved in this conflict.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        },
        "rule": {
          "description": "Semantic rule establishing the conflict and its admissible resolution boundary.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        }
      },
      "required": [
        "evidence",
        "kind",
        "left",
        "resource",
        "right",
        "rule"
      ],
      "type": "object"
    },
    "parallelSafetyPair": {
      "additionalProperties": false,
      "properties": {
        "conflicts": {
          "description": "Typed conflicts with their semantic basis; zero entries does not authenticate compatibility.",
          "items": {
            "$ref": "#/$defs/parallelSafetyConflict"
          },
          "maxItems": 1024,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "evidence": {
          "description": "Original current evidence authenticating this pair's scope/resource analysis.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "left": {
          "description": "Exact left transition member, distinct and within the assessed cohort.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        },
        "leftRead": {
          "description": "Canonical repository-relative leftRead scope; overlap interpreted only by the admitted scope evaluator.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "leftResources": {
          "description": "Exact shared authority, integration ownership, provider/account, external mutation, evidence and recovery resources.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "leftWrite": {
          "description": "Canonical repository-relative leftWrite scope; overlap interpreted only by the admitted scope evaluator.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "outcome": {
          "description": "Pair classification from authenticated conflict analysis, never topology alone.",
          "enum": [
            "compatible",
            "conflict"
          ],
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "right": {
          "description": "Exact right transition member, distinct and within the assessed cohort.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        },
        "rightRead": {
          "description": "Canonical repository-relative rightRead scope; overlap interpreted only by the admitted scope evaluator.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "rightResources": {
          "description": "Exact shared authority, integration ownership, provider/account, external mutation, evidence and recovery resources.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "rightWrite": {
          "description": "Canonical repository-relative rightWrite scope; overlap interpreted only by the admitted scope evaluator.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "rule": {
          "description": "Exact admitted conflict-analysis rule covering file and non-file resources.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        }
      },
      "required": [
        "conflicts",
        "evidence",
        "left",
        "leftRead",
        "leftResources",
        "leftWrite",
        "outcome",
        "right",
        "rightRead",
        "rightResources",
        "rightWrite",
        "rule"
      ],
      "type": "object"
    },
    "parallelSafetyProved": {
      "additionalProperties": false,
      "properties": {
        "assessmentRule": {
          "description": "Graph-owned assessment and currentness rule, not a caller-selected workflow.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/parallelSafetyBasis",
          "description": "Independent currentness and verification basis; all domain digests and evidence require authenticated evaluation."
        },
        "conflicts": {
          "description": "A proved assessment has no remaining conflicts; absence alone never establishes proof.",
          "items": {
            "$ref": "#/$defs/parallelSafetyConflict"
          },
          "maxItems": 0,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "members": {
          "description": "Exact transition cohort assessed; completeness requires the current semantic member denominator.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "pairs": {
          "description": "Explicit pair assessments must cover the required concurrent-pair denominator without duplicates.",
          "items": {
            "$ref": "#/$defs/parallelSafetyPair"
          },
          "maxItems": 1024,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "semanticBasis": {
          "description": "Exact observed semantic closure digest in its SHA-256 domain; structural validity does not authenticate currentness.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        },
        "state": {
          "const": "proved",
          "description": "Assessment classification only; the proved tag never authenticates its own claim.",
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "assessmentRule",
        "basis",
        "conflicts",
        "members",
        "pairs",
        "semanticBasis",
        "state"
      ],
      "type": "object"
    },
    "parallelSafetyUnproven": {
      "additionalProperties": false,
      "properties": {
        "assessmentRule": {
          "description": "Graph-owned assessment and currentness rule, not a caller-selected workflow.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        },
        "members": {
          "description": "Exact transition cohort assessed; completeness requires the current semantic member denominator.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "missingObligations": {
          "description": "Exact missing assessment/evidence obligations; topology and empty conflicts cannot satisfy them.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "reasonCodes": {
          "description": "Bounded machine-readable refusal reasons, not execution instructions.",
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "semanticBasis": {
          "description": "Exact observed semantic closure digest in its SHA-256 domain; structural validity does not authenticate currentness.",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        },
        "state": {
          "const": "unproven",
          "description": "Assessment classification only; the proved tag never authenticates its own claim.",
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "assessmentRule",
        "members",
        "missingObligations",
        "reasonCodes",
        "semanticBasis",
        "state"
      ],
      "type": "object"
    }
  },
  "$id": "urn:usf:cli-parallel-safety:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/parallelSafetyBlocked"
    },
    {
      "$ref": "#/$defs/parallelSafetyProved"
    },
    {
      "$ref": "#/$defs/parallelSafetyUnproven"
    }
  ]
}
