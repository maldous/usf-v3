{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:account-source-authorization:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "routeMemberDigest",
    "profileDigest",
    "effectivePolicyDigest",
    "privacyProjectionDigest",
    "accountSourceProtocolDigest",
    "endpointIdentity",
    "method",
    "credentialName",
    "maximumResponseBytes",
    "timeoutMilliseconds",
    "issuedAt",
    "expiresAt",
    "inferenceProhibited",
    "fallbackProhibited"
  ],
  "properties": {
    "schema": { "const": "urn:usf:account-source-authorization:1" },
    "version": { "const": 1 },
    "routeMemberDigest": { "$ref": "#/$defs/digest" },
    "profileDigest": { "$ref": "#/$defs/digest" },
    "effectivePolicyDigest": { "$ref": "#/$defs/digest" },
    "privacyProjectionDigest": { "$ref": "#/$defs/digest" },
    "accountSourceProtocolDigest": { "$ref": "#/$defs/digest" },
    "endpointIdentity": {
      "type": "string",
      "minLength": 9,
      "pattern": "^https://"
    },
    "method": { "const": "GET" },
    "credentialName": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
    },
    "maximumResponseBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "timeoutMilliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    },
    "issuedAt": { "$ref": "#/$defs/instant" },
    "expiresAt": { "$ref": "#/$defs/instant" },
    "inferenceProhibited": { "const": true },
    "fallbackProhibited": { "const": true }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
