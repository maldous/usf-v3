{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:provider-host-authorization:1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "transport",
    "provider",
    "catalogueProvider",
    "executable",
    "executableVersion",
    "authenticationDigest",
    "modelSurfaceDigest",
    "modelSurfaceCompleteness",
    "environmentPolicyDigest",
    "containmentDigest",
    "observedAt",
    "expiresAt",
    "scope",
    "inferenceAuthorized",
    "fallbackProhibited",
    "apiAndCloudCredentialEnvironmentForwarded",
    "authorizationDisposition",
    "digest"
  ],
  "properties": {
    "schema": { "const": "urn:usf:provider-host-authorization:1" },
    "version": { "const": 1 },
    "transport": { "enum": ["codex-cli-subscription", "claude-cli-subscription"] },
    "provider": { "enum": ["codex-cli", "claude-cli"] },
    "catalogueProvider": { "enum": ["openai", "anthropic"] },
    "executable": { "type": "string", "pattern": "^/[^\\u0000-\\u001f\\u007f]{1,4095}$" },
    "executableVersion": { "$ref": "#/$defs/token" },
    "authenticationDigest": { "$ref": "#/$defs/digest" },
    "modelSurfaceDigest": { "$ref": "#/$defs/digest" },
    "modelSurfaceCompleteness": { "enum": ["bounded-union-not-live-entitlement", "frozen-catalogue-only-not-live-entitlement", "non-exhaustive"] },
    "environmentPolicyDigest": { "$ref": "#/$defs/digest" },
    "containmentDigest": { "$ref": "#/$defs/digest" },
    "observedAt": { "$ref": "#/$defs/instant" },
    "expiresAt": { "$ref": "#/$defs/instant" },
    "scope": { "const": "host-status-and-model-census" },
    "inferenceAuthorized": { "const": false },
    "fallbackProhibited": { "const": true },
    "apiAndCloudCredentialEnvironmentForwarded": { "const": false },
    "authorizationDisposition": { "const": "authorized" },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "instant": { "type": "string", "format": "date-time" },
    "token": { "type": "string", "minLength": 1 }
  }
}
