        "environment-observation"
      ]
    },
    "sourceIdentity": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "evidenceIdentity": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
