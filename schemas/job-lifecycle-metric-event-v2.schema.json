            "evidenceIdentity": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Za-z0-9._:-]{1,160}$"
            },
            "missingnessReason": {
              "type": [
                "string",
                "null"
              ]
            },
            "amount": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000000000
            },
            "currency": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Z]{3}$"
