{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:provider-source-state-head-set:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "scopeDigest",
    "headManifestDigests",
    "deferredSourceAttempts",
    "generation",
    "previousHeadSetRecordDigest",
    "producerProtocolDigest",
    "updatedAt",
    "nonClaims"
  ],
  "properties": {
    "schema": {
      "const": "urn:usf:provider-source-state-head-set:1"
    },
    "version": {
      "const": 1
    },
    "scopeDigest": {
      "$ref": "#/$defs/digest"
    },
    "headManifestDigests": {
      "type": "array",
      "minItems": 0,
      "maxItems": 33,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "deferredSourceAttempts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/deferredAttempt"
      }
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "previousHeadSetRecordDigest": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "producerProtocolDigest": {
      "$ref": "#/$defs/digest"
    },
    "updatedAt": {
      "$ref": "#/$defs/instant"
    },
    "nonClaims": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "iri": {
      "type": "string",
      "minLength": 5,
      "pattern": "^urn:[^<>\\s]+$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{0,191}$"
    },
    "credentialName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
    },
    "decimal": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]{1,95}(?::[^\\s]{1,192})?$"
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "deferredAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountSourceKeyDigest",
        "attemptDigest",
        "retryAfter"
      ],
      "properties": {
        "accountSourceKeyDigest": {
          "$ref": "#/$defs/digest"
        },
        "attemptDigest": {
          "$ref": "#/$defs/digest"
        },
        "retryAfter": {
          "$ref": "#/$defs/instant"
        }
      }
    }
  }
}
