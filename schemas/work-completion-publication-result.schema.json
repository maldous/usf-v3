{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:work-completion-publication-result:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "mode", "publicationState", "profileIri", "manifestPath", "memberCount", "works", "publicationIntentDigest", "publicationReceiptPath", "receiptDigest", "resultingSemanticDigest", "nonClaims"],
  "properties": {
    "schema": { "const": "urn:usf:work-completion-publication-result:1" },
    "status": { "const": "verified" },
    "mode": { "enum": ["verify", "apply"] },
    "publicationState": { "enum": ["absent", "matching", "created"] },
    "profileIri": { "$ref": "#/$defs/iri" },
    "manifestPath": { "$ref": "#/$defs/path" },
    "memberCount": { "type": "integer", "minimum": 1, "maximum": 32 },
    "works": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/iri" } },
    "publicationIntentDigest": { "$ref": "#/$defs/digest" },
    "publicationReceiptPath": { "type": "string", "pattern": "^evidence/work-completion/[0-9a-f]{64}\\.json$" },
    "receiptDigest": { "$ref": "#/$defs/digest" },
    "resultingSemanticDigest": { "$ref": "#/$defs/digest" },
    "nonClaims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "iri": { "type": "string", "pattern": "^urn:[^<>\\s]+$" },
    "path": { "type": "string", "pattern": "^(?!\\.git(?:/|$))(?!\\.usf(?:/|$))(?!\\.env(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" }
  }
}
