{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:account-source-attempt:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "accountSourceKeyDigest",
    "acquisitionAuthorizationDigest",
    "credentialSourceIdentityDigest",
    "accountSourceProtocolDigest",
    "responseMappingDigest",
    "retryPolicyDigest",
    "previousAttemptDigests",
    "attemptedAt",
    "windowStartedAt",
    "windowExpiresAt",
    "retryAfter",
    "delayMilliseconds",
    "failureClass",
    "failureDigest",
    "attemptOrdinal",
    "attemptWindowDigest",
    "maximumAttemptsInWindow",
    "disposition",
    "nonClaims"
  ],
  "properties": {
    "schema": {
      "const": "urn:usf:account-source-attempt:1"
    },
    "version": {
      "const": 1
    },
    "accountSourceKeyDigest": {
      "$ref": "#/$defs/digest"
    },
    "acquisitionAuthorizationDigest": {
      "$ref": "#/$defs/digest"
    },
    "credentialSourceIdentityDigest": {
      "$ref": "#/$defs/digest"
    },
    "accountSourceProtocolDigest": {
      "$ref": "#/$defs/digest"
    },
    "responseMappingDigest": {
      "$ref": "#/$defs/digest"
    },
    "retryPolicyDigest": {
      "$ref": "#/$defs/digest"
    },
    "previousAttemptDigests": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "attemptedAt": {
      "$ref": "#/$defs/instant"
    },
    "windowStartedAt": {
      "$ref": "#/$defs/instant"
    },
    "windowExpiresAt": {
      "$ref": "#/$defs/instant"
    },
    "retryAfter": {
      "$ref": "#/$defs/instant"
    },
    "delayMilliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    },
    "failureClass": {
      "enum": [
        "transport",
        "timeout",
        "authentication",
        "authorization",
        "rate-limit",
        "response-invalid",
        "response-oversize",
        "persistence",
        "unknown"
      ]
    },
    "failureDigest": {
      "$ref": "#/$defs/digest"
    },
    "attemptOrdinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "attemptWindowDigest": {
      "$ref": "#/$defs/digest"
    },
    "maximumAttemptsInWindow": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "disposition": {
      "enum": [
        "deferred",
        "circuit-open",
        "exhausted"
      ]
    },
    "nonClaims": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "iri": {
      "type": "string",
      "minLength": 5,
      "pattern": "^urn:[^<>\\s]+$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{0,191}$"
    },
    "credentialName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
    },
    "decimal": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]{1,95}(?::[^\\s]{1,192})?$"
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  }
}
