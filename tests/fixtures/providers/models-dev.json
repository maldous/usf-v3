{
  "zeta-router": {
    "id": "zeta-router",
    "name": "Zeta Router",
    "npm": "@ai-sdk/zeta",
    "env": ["302AI_API_KEY", "ZETA_TOKEN"],
    "models": {
      "zeta/unknown-model": {
        "id": "zeta/unknown-model",
        "name": "Unknown Price Model",
        "family": "zeta-family",
        "attachment": false,
        "reasoning": true,
        "tool_call": true,
        "modalities": { "input": ["text"], "output": ["text"] },
        "open_weights": false,
        "limit": { "context": 8192, "output": 2048 },
        "ignored_upstream_field": "forward-compatible"
      }
    }
  },
  "alpha-direct": {
    "id": "alpha-direct",
    "name": "Alpha Direct",
    "npm": "@ai-sdk/alpha",
    "env": ["ALPHA_REGION", "ALPHA_TOKEN"],
    "models": {
      "alpha-paid": {
        "id": "alpha-paid",
        "name": "Alpha Paid",
        "family": "alpha-family",
        "attachment": false,
        "reasoning": false,
        "structured_output": true,
        "temperature": true,
        "tool_call": true,
        "modalities": { "input": ["text"], "output": ["text"] },
        "open_weights": false,
        "cost": { "input": 0.2, "output": 0.8, "cache_read": 0.1 },
        "limit": { "context": 32768, "input": 30000, "output": 4096 }
      },
      "alpha-zero": {
        "id": "alpha-zero",
        "name": "Alpha Zero",
        "family": "alpha-family",
        "attachment": true,
        "reasoning": true,
        "structured_output": true,
        "temperature": false,
        "tool_call": true,
        "modalities": { "input": ["text", "image"], "output": ["text"] },
        "open_weights": true,
        "cost": { "input": 0, "output": 0, "reasoning": 0, "cache_read": 0, "cache_write": 0 },
        "limit": { "context": 65536, "input": 60000, "output": 8192 }
      }
    }
  }
}
