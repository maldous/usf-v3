profile usf-fixture-process-v1 flags=(attach_disconnected,mediate_deleted) {
  /** rwlk,

  signal,

  unix (create, getattr, getopt) type=stream addr=none,
  unix (send, receive) type=stream addr=none peer=(label=@{profile_name},addr=none),
  unix (send, receive) type=stream addr=none peer=(label=unconfined,addr=none),

  /usr/bin/node ix,
  /usr/bin/git ix,
  /usr/bin/flock ix,

  /lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 mr,
  /lib/aarch64-linux-gnu/ld-linux-aarch64.so.1 mr,
  /lib/x86_64-linux-gnu/*.so* mr,
  /usr/lib/x86_64-linux-gnu/*.so* mr,
  /lib/aarch64-linux-gnu/*.so* mr,
  /usr/lib/aarch64-linux-gnu/*.so* mr,
}
